# 环境备份默认忽略；内部仓库的实际环境配置在文件末尾显式放行。
.env
.env.*
*.pem
*.key

# Python 环境、构建产物及下载缓存。
.venv*/
venv/
build/
dist/
*.egg-info/
.wheels/*
!.wheels/.gitkeep
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# 编辑器和操作系统临时文件。
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp

# 只忽略根目录私有规则；app/config/ 是配置读取源码，必须提交。
/config/
# 私有业务快照和数据库备份不属于源码。
outputs/
state/
backups/
*.dump
*.sql.gz
*.tar.gz
/deploy/image.ref


# Server-only release state and temporary registry credentials
/.ghcr-auth-*/
/incoming-*/
/releases/
/current
/previous
/pending
/releases.log
/pre-migrate.sh

# 自动发布的服务器就绪标记与原子状态临时文件
.deploy-ready
.current.tmp
.previous.tmp
.pending.tmp

# Runtime state and environment backups
.env
.env.*
.runtime/
.deploy-environment

# 用户指定：内部仓库提交实际环境和 Nginx 配置，不提交环境备份。
!.env
!.env.local
!.env.test
!.env.production
!.env.development.local
!nginx.conf
!deploy/nginx/*.conf
