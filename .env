# 本机私有配置：沿用原有有效值，字段及中文说明与 .env.example 对齐。
# 下方生产示例说明供迁移参考，不代表本机的值；切勿提交此文件。
# UTF-8，无 BOM。本文件保留本机配置；服务器请使用 .env.example 中的生产示例。
# 本地和服务器字段一致，值分别维护；账号、密码、Cookie 和 Token 不提交 Git。
# 【必填】数据库 DSN、服务 Token、收单账号和密码。

# 运行环境：服务器 production；本地 local。日志级别由启动命令 --loglevel 设置。
SAVEB_APP_ENV=local
DEPLOY_NETWORK=saveb-production
# 仅生产 Compose 使用此端口；本地 Docker API 固定映射到 8085。
COLLECTOR_PORT=18085

# 【必填】与 saveb-api 的 DB_DATABASE / DB_USERNAME / DB_PASSWORD 对应。
# 密码包含 @、:、#、% 等字符时须 URL 编码；不能保留下面的密码占位符。
# 以下地址用于 Docker 容器；本地原生 Python 连接请使用实际宿主机地址和映射端口。
SAVEB_DATABASE_URL="postgresql://test:123456789abc@saveb-api-postgres:5432/test"
# Collector 专用 Redis：0=会话/锁，1=任务队列，2=任务结果；不是 API 的带密码 Redis。
SAVEB_REDIS_URL="redis://localhost:6379/0"
SAVEB_CELERY_BROKER_URL="redis://saveb-collector-redis:6379/1"
SAVEB_CELERY_RESULT_BACKEND="redis://saveb-collector-redis:6379/2"

# 【必填】与 API 的 SAVEB_COLLECTOR_TOKEN 完全相同，至少 32 个随机字符。
SAVEB_API_TOKEN="R6n2qJdEAOTbeYBiypEx6yEg6q38T5xErhARIlykb819JOo4SrDWOytqcEpvs51W"
SAVEB_SOURCE_ACCOUNT="default"
# true 才会同步写入 API 订单/统计表；false 仅保存 Collector 来源数据。
SAVEB_PUBLISH_API="true"

# 【必填账号密码】固定收单站点，不需要另填登录 URL；密码保留原有全角/半角字符。
# 含空格、# 或 $ 的值建议用英文单引号包裹；不要把完整 .env 发到聊天或提交 Git。
SAVEB_DH_BASE_URL="https://www.dh-order.com"
SAVEB_DH_USERNAME="dhdlz"
SAVEB_DH_PASSWORD="Djrjms85hy！"
# 使用账号密码登录时留空；只有明确采用已有会话才填写 Cookie。
SAVEB_DH_COOKIE=""
SAVEB_DH_LOGIN_ATTEMPTS=3
# 会话缓存秒数：28800=8 小时。
SAVEB_DH_SESSION_TTL=28800

# 请求超时（秒）、分页上限、请求间隔（秒）和失败尝试次数。
SAVEB_FETCH_TIMEOUT_SECONDS=240
SAVEB_MAX_PAGES=200
SAVEB_REQUEST_INTERVAL_SECONDS=0.5
SAVEB_MAX_ATTEMPTS=3
# 历史发现最早日期；上线前按实际历史范围核对。
SAVEB_HISTORY_START="2021-08-10"
# 留空使用 API 库中的规则和汇率上下文；自定义文件需挂载到 /app/config。
SAVEB_RULES_FILE=""
SAVEB_RATES_FILE=""

# 普通订单自动采集间隔在 Admin → 系统管理 → 采集管理中设置，保存在数据库。
# 以下是独立的历史 Pending 发现任务，不是首页普通订单自动采集间隔。
SAVEB_PENDING_ENABLED=true
SAVEB_PENDING_INTERVAL_MINUTES=30
SAVEB_PENDING_WINDOW_DAYS=7
SAVEB_PENDING_MAX_PAGES=10
SAVEB_PENDING_TIMEOUT_SECONDS=240

# 物流密钥未配置时关闭自动物流查询，配置后再启用。
SAVEB_LOGISTICS_ENABLED=true
SAVEB_AFTERSHIP_API_KEY=""
SAVEB_KUAIDI100_API_KEY=""
SAVEB_LOGISTICS_INTERVAL_MINUTES=30
SAVEB_LOGISTICS_BATCH_SIZE=20

# 下面三项只用于本地 Docker Compose，生产 Compose 不读取；通常保持默认。
SAVEB_API_NETWORK=saveb-api_saveb-api-net
SAVEB_DNS_PRIMARY=1.1.1.1
SAVEB_DNS_SECONDARY=8.8.8.8
