# Copy deliberately; never commit your real cookie or service token.
SAVEB_DATABASE_URL=postgresql://saveb:CHANGE_ME@saveb-api-postgres:5432/API_DATABASE
SAVEB_CELERY_BROKER_URL=redis://saveb-collector-redis:6379/1
SAVEB_CELERY_RESULT_BACKEND=redis://saveb-collector-redis:6379/2
SAVEB_API_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
SAVEB_DH_BASE_URL=https://www.dh-order.com
SAVEB_DH_COOKIE=
# Preferred: account login, CAPTCHA handled locally, session shared in Redis.
SAVEB_DH_USERNAME=
SAVEB_DH_PASSWORD=
SAVEB_DH_LOGIN_ATTEMPTS=3
SAVEB_DH_SESSION_TTL=28800
SAVEB_SOURCE_ACCOUNT=default
# false = collector schema only; true = also project to saveb-api orders/statistics tables.
SAVEB_PUBLISH_API=true
SAVEB_HISTORY_START=2021-08-10
# Leave empty to use saveb-api legacy_dashboard_context and confirmed influencer domains.
SAVEB_RULES_FILE=
SAVEB_RATES_FILE=
SAVEB_FETCH_TIMEOUT_SECONDS=60
SAVEB_REQUEST_INTERVAL_SECONDS=0.5
SAVEB_MAX_PAGES=200
SAVEB_MAX_ATTEMPTS=3

# Independent Pending discovery; Beat checks due time every 60 seconds.
SAVEB_PENDING_ENABLED=true
SAVEB_PENDING_INTERVAL_MINUTES=30
SAVEB_PENDING_WINDOW_DAYS=7
SAVEB_PENDING_MAX_PAGES=10
SAVEB_PENDING_TIMEOUT_SECONDS=240

# Logistics: separate worker/queue. Auto prefers AfterShip, then Kuaidi100 stdio API.
SAVEB_AFTERSHIP_API_KEY=
SAVEB_KUAIDI100_API_KEY=
SAVEB_LOGISTICS_ENABLED=true
SAVEB_LOGISTICS_INTERVAL_MINUTES=30
SAVEB_LOGISTICS_BATCH_SIZE=20

